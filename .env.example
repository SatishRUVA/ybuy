VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Set main for the original main site; leave unset for the redesign deployment.
VITE_SITE_VARIANT=
# Sign-in buttons shown in the dialog. Google is always on; add facebook and/or apple only after
# enabling that provider (client ID + secret) in Supabase Auth, otherwise the button errors.
VITE_AUTH_PROVIDERS=google,facebook,apple
# Temporary PROD-only, site-wide TOTP access gate. See middleware.js / api/access/verify.js.
# When false (or unset), the app behaves exactly as before — no gate, no redirect.
YBUY_TEMP_ACCESS_ENABLED=false

# Server-side only — NEVER prefix with VITE_ or it will be bundled into the browser.
# Base32 secret (RFC 4226/6238), e.g. generate with: openssl rand -base64 20 | base32
YBUY_TOTP_SECRET=

# Server-side only — signs the temporary access session cookie. Generate with: openssl rand -hex 32
YBUY_ACCESS_SESSION_SECRET=

# Server-side only — pass this file to `supabase functions serve --env-file .env.local`.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:5173
RESEND_WEBHOOK_SECRET=
# Safe default: redirect local/test email to this controlled inbox.
NOTIFICATION_TEST_RECIPIENT=
# Set true only in the production Edge Function environment after sender verification.
NOTIFICATION_LIVE_DELIVERY=false
# Stops notification delivery entirely, including redirected test mail.
NOTIFICATION_DELIVERY_DISABLED=false
# Hosted synthetic Owner/Renter picker: exact test site only; requires server-side tester gate.
VITE_TEST_PROFILE_LOGIN=false
YBUY_TEST_PROFILE_LOGIN=false
# Server-side only; match Supabase Vault's notification_worker_secret for scheduled delivery.
NOTIFICATION_WORKER_SECRET=
